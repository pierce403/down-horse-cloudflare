{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "down-horse", "main": "src/worker.mjs", "compatibility_date": "2026-10-12",
  "workers_dev": true, "preview_urls": false,
  "assets": {"directory": "build/assets", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none"},
  "observability": {"enabled": true, "traces": {"enabled": true}},
  "env": {"staging": {"name": "down-horse-staging", "preview_urls": false}}
}
